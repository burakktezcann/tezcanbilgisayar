{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tezcan Bilgisayar Catalog",
  "type": "object",
  "required": ["schemaVersion", "currency", "categories", "products"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "name", "description", "icon", "tone", "sortOrder", "searchTerms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "type": "string", "pattern": "^fa-[a-z0-9-]+$" },
        "tone": { "enum": ["blue", "green", "purple", "orange"] },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "searchTerms": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["id", "categoryId", "name", "description", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "categoryId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "sku": { "type": "string" },
        "image": { "type": "string", "pattern": "^(assets/products/[A-Za-z0-9._/-]+|https://[A-Za-z0-9.-]+/storage/v1/object/public/product-images/[A-Za-z0-9._/-]+)$" },
        "price": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "stock": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["draft", "active"] },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "searchTerms": { "type": "array", "items": { "type": "string" } },
        "attributes": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      },
      "additionalProperties": false
    }
  }
}

